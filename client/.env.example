# Konlife FastAPI base URL (no trailing slash).
#
# Desktop web / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Optional public origin for shared night links (no trailing slash).
# When unset, the current page origin is used.
# EXPO_PUBLIC_SHARE_ORIGIN=https://konstanz.app
#
# Android emulator:  http://10.0.2.2:8000
# Phone on LAN: omit this, or the app uses the page hostname (e.g. 192.168.x.x:8000).
