{
  "expo": {
    "name": "KonVita",
    "slug": "konvita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "konvita",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#161616",
    "primaryColor": "#F2F862",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.konvita.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161616",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "navigationBarColor": "#161616",
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#161616"
      },
      "package": "com.konvita.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "KonVita",
      "shortName": "KonVita",
      "lang": "en",
      "themeColor": "#161616",
      "backgroundColor": "#161616",
      "display": "standalone",
      "orientation": "any",
      "startUrl": "/",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      "react-native-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KonVita uses your location to set the taxi pickup."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#161616"
        }
      ],
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
