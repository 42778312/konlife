│   │   └── globals.css  # Dark theme tokens, neon yellow variables, custom scrollbars
│   ├── components/
│   │   ├── ui/          # shadcn/ui components (Button, Card, Badge, Input, etc.)
│   │   ├── layout/
│   │   │   ├── WebHeader.tsx
│   │   │   ├── MobileHeader.tsx
│   │   │   ├── MobileBottomNav.tsx
│   │   │   └── ViewportSwitcher.tsx
│   │   ├── events/
│   │   │   ├── EventCardWeb.tsx
│   │   │   ├── EventCardMobile.tsx
│   │   │   ├── MapWidget.tsx
│   │   │   └── CategoryFilterBar.tsx
│   ├── data/
│   │   └── mockEvents.ts
│   └── lib/
│       └── utils.ts
├── package.json
└── tailwind.config.js
```

