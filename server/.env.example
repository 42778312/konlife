# Upstream
PARTY_INSIDER_BASE_URL=https://www.party-insider.com/wp-json
DEFAULT_CITY=Konstanz
TIMEZONE=Europe/Zurich

# Cache: memory (dev, plus .cache/ on disk so --reload stays fast)
# redis (production — requires Redis running, e.g. docker compose)
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
PERSIST_CACHE=true
CACHE_DIR=.cache
WARM_ON_STARTUP=true

# TTLs (seconds). Fresh window + longer stale-while-revalidate.
EVENT_CACHE_TTL=900
EVENT_CACHE_STALE_TTL=21600
VENUE_CACHE_TTL=3600
VENUE_CACHE_STALE_TTL=86400
CATEGORY_CACHE_TTL=3600
TAG_CACHE_TTL=3600
ORGANIZER_CACHE_TTL=3600

# Limits
MAX_PAGES=20
DEFAULT_PER_PAGE=20
MAX_PER_PAGE=100
UPSTREAM_PER_PAGE=50
MAX_CONCURRENT_VENUE_REQUESTS=5

# Party classifier
PARTY_ONLY_DEFAULT=true
PARTY_KEYWORDS=party,parties,club,clubnight,club night,nacht,night,disco,dj,dance,techno,house,electro,electronic,hip hop,rap,rave,festival,event,feiern,tanz,nachtleben,afterhour,open air,openair

# HTTP client
HTTP_TIMEOUT=15.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE=0.3

# CORS (comma-separated, no wildcard in production)
# Include Expo web (8081 / 19006) plus common Vite/Next ports.
# Private LAN origins (phones on Wi-Fi) are also allowed via cors_origin_regex in config.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173

# App
APP_NAME=Party-Insider Konstanz API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
